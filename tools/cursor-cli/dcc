#!/usr/bin/env bash
# dcc — dotfiles cursor CLI: launch a named agent role in Claude or Codex.
#
# Usage:
#   dcc <shortcut> [args...]
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
ROLES_DIR="${ROOT}/cursor/_roles"
ROLE_ORDER=(mod tw pa pe)

die() {
  echo "dcc: $*" >&2
  exit 1
}

shortcut_spec() {
  case "$1" in
    mod) printf '%s\n' 'mod|codex|gpt-5.3-codex-spark|low|fast' ;;
    tw) printf '%s\n' 'tw|claude|claude-sonnet-4-6|medium' ;;
    pa) printf '%s\n' 'pa|claude|claude-opus-4-7|xhigh' ;;
    pe) printf '%s\n' 'pe|codex|gpt-5.5|medium|fast' ;;
    *) return 1 ;;
  esac
}

json_string_field() {
  local file="$1" field="$2"
  if command -v jq >/dev/null 2>&1; then
    jq -er --arg field "$field" '.[$field] // empty | select(type == "string")' "$file"
    return
  fi

  sed -nE 's/^[[:space:]]*"'"$field"'"[[:space:]]*:[[:space:]]*"([^"\\]*)".*/\1/p' "$file" | head -n 1
}

role_display_name() {
  local shortcut="$1" path key display_name
  path="$ROLES_DIR/$shortcut.json"
  [[ -f "$path" ]] || die "role file missing: $path"
  key="$(json_string_field "$path" key 2>/dev/null || true)"
  [[ "$key" == "$shortcut" ]] || die "role key mismatch: $shortcut (file: ${shortcut}.json)"
  display_name="$(json_string_field "$path" displayName 2>/dev/null || true)"
  [[ -n "$display_name" ]] || die "role missing displayName: $shortcut"
  printf '%s\n' "$display_name"
}

launcher_display() {
  case "$1" in
    codex)  printf '%s\n' Codex ;;
    claude) printf '%s\n' Claude ;;
    *)      return 1 ;;
  esac
}

terminal_title_enabled() {
  [[ -t 1 || "${DCC_FORCE_TITLE:-}" == 1 ]]
}

emit_terminal_title() {
  local title="$1"
  if terminal_title_enabled; then
    printf '\033]0;%s\007' "$title"
  fi
}

refresh_terminal_title() {
  local title="$1" child_pid="$2"
  local interval="${DCC_TITLE_INTERVAL:-0.25}"
  local -i attempts="${DCC_TITLE_REASSERTS:-8}"
  local -i index

  terminal_title_enabled || return 0
  for ((index = 0; index < attempts; index++)); do
    sleep "$interval" || return 0
    kill -0 "$child_pid" 2>/dev/null || return 0
    emit_terminal_title "$title"
  done
}

usage() {
  printf 'Usage: dcc <shortcut> [args...]\n\n'
  printf 'Shortcuts:\n'

  local shortcut launcher model display_name launcher_name spec effort service_tier
  local -i width=0
  for shortcut in "${ROLE_ORDER[@]}"; do
    (( ${#shortcut} > width )) && width=${#shortcut}
  done

  for shortcut in "${ROLE_ORDER[@]}"; do
    spec="$(shortcut_spec "$shortcut")" || die "missing shortcut spec: $shortcut"
    IFS='|' read -r _ launcher model effort service_tier <<< "$spec"
    launcher_name="$(launcher_display "$launcher")" || die "unsupported launcher for shortcut: $shortcut"
    display_name="$(role_display_name "$shortcut")"
    case "$launcher" in
      codex)
        printf "  %-${width}s  Open %s as \"%s\" with model %s, service tier %s, and effort %s\n" "$shortcut" "$launcher_name" "$display_name" "$model" "$service_tier" "$effort"
        ;;
      claude)
        printf "  %-${width}s  Open %s as \"%s\" with model %s and effort %s\n" "$shortcut" "$launcher_name" "$display_name" "$model" "$effort"
        ;;
      *)
        printf "  %-${width}s  Open %s as \"%s\" with model %s\n" "$shortcut" "$launcher_name" "$display_name" "$model"
        ;;
    esac
  done

  printf '\nOptions:\n'
  printf '  -h, --help                  Show this help text\n'
  printf '      --yes-all               Alias; prompt skipping is the default\n'
  printf '      --skip-all-prompts      Alias for --yes-all\n'
}

run_codex() {
  local role="$1" model="$2" effort service_tier
  effort="$3"
  service_tier="$4"
  shift 4
  command -v codex >/dev/null 2>&1 || die "codex not found in PATH"
  bash -c 'exec -a "$0" "$@"' "$role" codex -m "$model" -c "service_tier=\"$service_tier\"" -c "model_reasoning_effort=$effort" "$@"
}

run_claude() {
  local role="$1" model="$2" effort
  effort="$3"
  shift 3
  command -v claude >/dev/null 2>&1 || die "claude not found in PATH"
  bash -c 'exec -a "$0" "$@"' "$role" claude --model "$model" --effort "$effort" "$@"
}


launch_with_title() {
  local shortcut="$1" agent_id="$2" runner="$3"
  shift 3

  local title title_pid status
  title="$shortcut ($agent_id)"
  emit_terminal_title "$title"

  refresh_terminal_title "$title" "$$" &
  title_pid="$!"

  status=0
  "$runner" "$@" || status="$?"
  kill "$title_pid" 2>/dev/null || true
  wait "$title_pid" 2>/dev/null || true
  emit_terminal_title "$title"
  return "$status"
}

launch_shortcut() {
  local shortcut="$1"
  shift

  local spec launcher model effort service_tier
  local -a forwarded_args=()
  spec="$(shortcut_spec "$shortcut")" || die "unknown shortcut: $shortcut (use --help)"
  IFS='|' read -r _ launcher model effort service_tier <<< "$spec"
  role_display_name "$shortcut" >/dev/null
  [[ -n "$model" ]] || die "role missing model: $shortcut"
  [[ -n "$effort" ]] || die "role missing effort: $shortcut"
  if [[ "$launcher" == codex ]]; then
    [[ -n "$service_tier" ]] || die "role missing service tier: $shortcut"
  fi

  while (($#)); do
    case "$1" in
      --yes-all|--skip-all-prompts)
        ;;
      --)
        shift
        forwarded_args+=("$@")
        break
        ;;
      *)
        forwarded_args+=("$1")
        ;;
    esac
    shift
  done

  case "$launcher" in
    codex)
      launch_with_title "$shortcut" "$model" run_codex "$shortcut" "$model" "$effort" "$service_tier" "${forwarded_args[@]+"${forwarded_args[@]}"}"
      ;;
    claude)
      launch_with_title "$shortcut" "$model" run_claude "$shortcut" "$model" "$effort" "${forwarded_args[@]+"${forwarded_args[@]}"}"
      ;;
    *)      die "unsupported launcher for shortcut: $shortcut" ;;
  esac
}

shortcut="${1:-}"
case "$shortcut" in
  -h|--help) usage ;;
  "")        usage; exit 1 ;;
  *)         shift; launch_shortcut "$shortcut" "$@" ;;
esac
