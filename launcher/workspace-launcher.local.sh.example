#!/bin/zsh
# Copy to workspace-launcher.local.sh (gitignored) and customize.
#
# Each workspace entry is "Label|/absolute/path". Labels appear in the picker.
# Add rows for whatever folders you use; this example does not assume other fixed paths on disk.

typeset -ga WORKSPACE_ENTRIES=(
  "Example workspace|/path/to/your-workspace"
)

# Picker opens on this label; leave empty to use the first entry.
DEFAULT_WORKSPACE_LABEL="Example workspace"

# Open vs Append is chosen in the picker UI (mode radio buttons), then OK.

# Optional: extra PNG paths to try for the app icon (defaults live in lib/config.sh).
# ICON_CANDIDATE_PATHS+=("$HOME/path/to/dotfiles/launcher/icons/icon-2d.png")
