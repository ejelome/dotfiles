# Identity: use ~/.gitconfig.local so this file can stay repo-clean when symlinked.
# Copy gitconfig.local.example there and set name/email (see README **Install**).
[include]
	path = ~/.gitconfig.local
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
